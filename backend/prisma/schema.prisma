generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                       @id @default(autoincrement())
  name              String
  email             String                    @unique
  phone             String?
  password          String
  photoUrl          String?
  fcmToken          String?
  createdAt         DateTime                  @default(now())
  bookings          Booking[]
  chatThreads       ChatThread[]
  checkIns          CheckIn[]
  consultations     ConsultationAccess[]
  memberPackages    MemberPackage[]
  stats             MemberStats?
  messagesSent      Message[]
  orders            Order[]
  payments          Payment[]
  providerPurchases ProviderPackagePurchase[]
  reviews           Review[]
  sessions          TrainingSession[]
  badges            UserBadge[]
  preference        UserPreference?
}

model UserPreference {
  id                  Int     @id @default(autoincrement())
  userId              Int     @unique
  bookingConfirm      Boolean @default(true)
  sessionReminders    Boolean @default(true)
  offersAndPromotions Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id])
}

model GymAdmin {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  password        String
  createdAt       DateTime        @default(now())
  scans           CheckIn[]
  gyms            Gym[]
  payoutDecisions PayoutRequest[]
}

model Gym {
  id             Int             @id @default(autoincrement())
  adminId        Int
  name           String
  address        String
  latitude       Float?
  longitude      Float?
  openingTime    String
  closingTime    String
  capacity       Int
  photos         String[]
  amenities      String[]
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  bookings       Booking[]
  checkIns       CheckIn[]
  earnings       Earning[]
  admin          GymAdmin        @relation(fields: [adminId], references: [id])
  staff          GymStaff[]
  memberPackages MemberPackage[]
  orders         Order[]
  packages       Package[]
  payoutRequests PayoutRequest[]
  providers      Provider[]

  @@index([name])
  @@index([address])
}

model Package {
  id             Int             @id @default(autoincrement())
  gymId          Int
  name           String
  type           PackageType     @default(daily)
  price          Float
  durationDays   Int
  benefits       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  maxVisits      Int?
  allowedDays    Int[]           @default([])
  allowedPeriods Period[]        @default([])
  maxGroupSize   Int             @default(1)
  bookings       Booking[]
  memberPackages MemberPackage[]
  gym            Gym             @relation(fields: [gymId], references: [id])
}

model Booking {
  id               Int               @id @default(autoincrement())
  userId           Int
  gymId            Int
  packageId        Int?
  slotStart        DateTime
  slotEnd          DateTime
  status           BookingStatus     @default(pending)
  qrCode           String?           @unique
  createdAt        DateTime          @default(now())
  bookingType      BookingType       @default(SINGLE)
  headcount        Int               @default(1)
  memberPackageId  Int?
  gym              Gym               @relation(fields: [gymId], references: [id])
  memberPackage    MemberPackage?    @relation("CoveredBookings", fields: [memberPackageId], references: [id])
  package          Package?          @relation(fields: [packageId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  checkIn          CheckIn[]
  purchasedPackage MemberPackage?    @relation("PurchaseBooking")
  order            Order?
  payment          Payment?
  sessions         TrainingSession[]

  @@index([gymId, slotStart, slotEnd])
}

model Payment {
  id               Int           @id @default(autoincrement())
  userId           Int
  bookingId        Int           @unique
  amount           Float
  currency         String        @default("ETB")
  status           PaymentStatus @default(pending)
  chapaTxRef       String?       @unique
  chapaCheckoutUrl String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime?
  booking          Booking       @relation(fields: [bookingId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
}

model Provider {
  id                 Int                       @id @default(autoincrement())
  type               ProviderType
  gymId              Int?
  name               String
  email              String                    @unique
  phone              String?
  password           String
  mustChangePassword Boolean                   @default(true)
  photoUrl           String?
  fcmToken           String?
  bio                String?
  specializations    String[]
  experienceYears    Int                       @default(0)
  certifications     String[]
  sharePercent       Int                       @default(100)
  isActive           Boolean                   @default(true)
  ratingAvg          Float                     @default(0)
  ratingCount        Int                       @default(0)
  sessionsCompleted  Int                       @default(0)
  createdAt          DateTime                  @default(now())
  consultationPrice  Decimal?                  @db.Decimal(12, 2)
  chatDays           Int?
  threads            ChatThread[]
  consultations      ConsultationAccess[]
  earnings           Earning[]
  messagesSent       Message[]
  orderItems         OrderItem[]
  payoutRequests     PayoutRequest[]
  gym                Gym?                      @relation(fields: [gymId], references: [id])
  availability       ProviderAvailability[]
  packages           ProviderPackage[]
  purchases          ProviderPackagePurchase[]
  reviews            Review[]
  sessions           TrainingSession[]
  badges             UserBadge[]

  @@index([gymId, type, isActive])
}

model ProviderAvailability {
  id         Int      @id @default(autoincrement())
  providerId Int
  dayOfWeek  Int
  period     Period
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, dayOfWeek, period])
}

model ProviderPackage {
  id           Int                       @id @default(autoincrement())
  providerId   Int
  name         String
  description  String?
  sessionCount Int
  price        Decimal                   @db.Decimal(12, 2)
  validityDays Int
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  orderItems   OrderItem[]
  provider     Provider                  @relation(fields: [providerId], references: [id])
  purchases    ProviderPackagePurchase[]
}

model GymStaff {
  id                 Int       @id @default(autoincrement())
  gymId              Int
  name               String
  email              String    @unique
  phone              String?
  password           String
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  scans              CheckIn[]
  gym                Gym       @relation(fields: [gymId], references: [id])

  @@index([gymId, isActive])
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  gymId             Int
  bookingId         Int         @unique
  totalAmount       Decimal     @db.Decimal(12, 2)
  needsManualRefund Boolean     @default(false)
  refundNote        String?
  createdAt         DateTime    @default(now())
  booking           Booking     @relation(fields: [bookingId], references: [id])
  gym               Gym         @relation(fields: [gymId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id                Int                      @id @default(autoincrement())
  orderId           Int
  type              OrderItemType
  label             String
  amount            Decimal                  @db.Decimal(12, 2)
  providerId        Int?
  providerPackageId Int?
  consultation      ConsultationAccess?
  earnings          Earning[]
  order             Order                    @relation(fields: [orderId], references: [id])
  provider          Provider?                @relation(fields: [providerId], references: [id])
  providerPackage   ProviderPackage?         @relation(fields: [providerPackageId], references: [id])
  purchase          ProviderPackagePurchase?
}

model MemberPackage {
  id                Int          @id @default(autoincrement())
  userId            Int
  gymId             Int
  packageId         Int
  purchaseBookingId Int          @unique
  startsAt          DateTime
  endsAt            DateTime
  maxVisits         Int?
  visitsUsed        Int          @default(0)
  status            AccessStatus @default(PENDING)
  coveredBookings   Booking[]    @relation("CoveredBookings")
  checkIns          CheckIn[]
  gym               Gym          @relation(fields: [gymId], references: [id])
  package           Package      @relation(fields: [packageId], references: [id])
  purchaseBooking   Booking      @relation("PurchaseBooking", fields: [purchaseBookingId], references: [id])
  user              User         @relation(fields: [userId], references: [id])

  @@index([userId, gymId, status])
}

model ProviderPackagePurchase {
  id                Int               @id @default(autoincrement())
  userId            Int
  providerId        Int
  providerPackageId Int
  orderItemId       Int               @unique
  packageName       String
  sessionsTotal     Int
  pricePaid         Decimal           @db.Decimal(12, 2)
  sessionsUsed      Int               @default(0)
  expiresAt         DateTime
  status            AccessStatus      @default(PENDING)
  createdAt         DateTime          @default(now())
  orderItem         OrderItem         @relation(fields: [orderItemId], references: [id])
  provider          Provider          @relation(fields: [providerId], references: [id])
  providerPackage   ProviderPackage   @relation(fields: [providerPackageId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  sessions          TrainingSession[]

  @@index([userId, status])
}

model TrainingSession {
  id           Int                     @id @default(autoincrement())
  purchaseId   Int
  bookingId    Int
  providerId   Int
  userId       Int
  startsAt     DateTime
  endsAt       DateTime
  status       SessionStatus           @default(HELD)
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                @default(now())
  cancelReason String?
  earnings     Earning?
  review       Review?
  booking      Booking                 @relation(fields: [bookingId], references: [id])
  provider     Provider                @relation(fields: [providerId], references: [id])
  purchase     ProviderPackagePurchase @relation(fields: [purchaseId], references: [id])
  user         User                    @relation(fields: [userId], references: [id])

  @@index([providerId, startsAt, endsAt])
  @@index([userId, status])
}

model ConsultationAccess {
  id           Int          @id @default(autoincrement())
  userId       Int
  orderItemId  Int          @unique
  consultantId Int?
  status       AccessStatus @default(PENDING)
  assignedAt   DateTime?
  startsAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  consultant   Provider?    @relation(fields: [consultantId], references: [id])
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([consultantId, status])
}

model ChatThread {
  id         Int       @id @default(autoincrement())
  userId     Int
  providerId Int
  createdAt  DateTime  @default(now())
  provider   Provider  @relation(fields: [providerId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  messages   Message[]

  @@unique([userId, providerId])
}

model Message {
  id               Int        @id @default(autoincrement())
  threadId         Int
  senderUserId     Int?
  senderProviderId Int?
  body             String
  createdAt        DateTime   @default(now())
  readAt           DateTime?
  senderProvider   Provider?  @relation(fields: [senderProviderId], references: [id])
  senderUser       User?      @relation(fields: [senderUserId], references: [id])
  thread           ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

model Review {
  id         Int             @id @default(autoincrement())
  sessionId  Int             @unique
  userId     Int
  providerId Int
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  provider   Provider        @relation(fields: [providerId], references: [id])
  session    TrainingSession @relation(fields: [sessionId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([providerId, createdAt])
}

model Badge {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  name       String
  audience   BadgeAudience
  userBadges UserBadge[]
}

model UserBadge {
  id         Int       @id @default(autoincrement())
  badgeId    Int
  userId     Int?
  providerId Int?
  awardedAt  DateTime  @default(now())
  badge      Badge     @relation(fields: [badgeId], references: [id])
  provider   Provider? @relation(fields: [providerId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
  @@unique([providerId, badgeId])
}

model MemberStats {
  userId               Int     @id
  totalWorkouts        Int     @default(0)
  currentStreak        Int     @default(0)
  longestStreak        Int     @default(0)
  lastWorkoutLocalDate String?
  user                 User    @relation(fields: [userId], references: [id])
}

model CheckIn {
  id               Int            @id @default(autoincrement())
  userId           Int
  gymId            Int
  bookingId        Int?
  memberPackageId  Int?
  localDate        String
  guestCount       Int            @default(1)
  checkedInAt      DateTime       @default(now())
  scannedByAdminId Int?
  scannedByStaffId Int?
  booking          Booking?       @relation(fields: [bookingId], references: [id])
  gym              Gym            @relation(fields: [gymId], references: [id])
  memberPackage    MemberPackage? @relation(fields: [memberPackageId], references: [id])
  scannedByAdmin   GymAdmin?      @relation(fields: [scannedByAdminId], references: [id])
  scannedByStaff   GymStaff?      @relation(fields: [scannedByStaffId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([bookingId, localDate])
  @@index([userId, gymId, localDate])
}

model Earning {
  id              Int              @id @default(autoincrement())
  providerId      Int
  gymId           Int
  orderItemId     Int
  sessionId       Int?             @unique
  payoutRequestId Int?
  amount          Decimal          @db.Decimal(12, 2)
  status          EarningStatus    @default(AVAILABLE)
  createdAt       DateTime         @default(now())
  gym             Gym              @relation(fields: [gymId], references: [id])
  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id])
  payoutRequest   PayoutRequest?   @relation(fields: [payoutRequestId], references: [id])
  provider        Provider         @relation(fields: [providerId], references: [id])
  session         TrainingSession? @relation(fields: [sessionId], references: [id])

  @@index([providerId, gymId, status])
}

model PayoutRequest {
  id               Int           @id @default(autoincrement())
  providerId       Int
  gymId            Int
  amount           Decimal       @db.Decimal(12, 2)
  status           PayoutStatus  @default(PENDING)
  paidMethod       PayoutMethod?
  paidReference    String?
  note             String?
  createdAt        DateTime      @default(now())
  decidedAt        DateTime?
  decidedByAdminId Int?
  earnings         Earning[]
  decidedBy        GymAdmin?     @relation(fields: [decidedByAdminId], references: [id])
  gym              Gym           @relation(fields: [gymId], references: [id])
  provider         Provider      @relation(fields: [providerId], references: [id])

  @@index([gymId, status])
}

model PlatformSetting {
  key         String  @id
  value       String
  description String?
}

enum PackageType {
  daily
  weekly
  monthly
  annual
}

enum BookingStatus {
  pending
  confirmed
  payment_failed
  cancelled
  checked_in
  expired
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ProviderType {
  TRAINER
  PHYSIOTHERAPIST
  NUTRITION_CONSULTANT
}

enum Period {
  MORNING
  AFTERNOON
  EVENING
}

enum BookingType {
  SINGLE
  GROUP
}

enum OrderItemType {
  GYM_BOOKING
  PROVIDER_PACKAGE
  CONSULTATION
}

enum SessionStatus {
  HELD
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AccessStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum EarningStatus {
  AVAILABLE
  REQUESTED
  PAID
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

enum PayoutMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum BadgeAudience {
  MEMBER
  PROVIDER
}
