generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int              @id @default(autoincrement())
  name                  String
  email                 String           @unique
  phone                 String?
  password              String
  photoUrl              String?
  fcmToken              String?
  createdAt             DateTime         @default(now())
  bookings              Booking[]
  conversationsAsMember Conversation[]
  payments              Payment[]
  reviews               TrainerReview[]
  trainerSessions       TrainerSession[] @relation("MemberTrainerSessions")
  preference            UserPreference?
}

model UserPreference {
  id                  Int     @id @default(autoincrement())
  userId              Int     @unique
  bookingConfirm      Boolean @default(true)
  sessionReminders    Boolean @default(true)
  offersAndPromotions Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id])
}

model GymAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  gyms      Gym[]
}

model Gym {
  id          Int       @id @default(autoincrement())
  adminId     Int
  name        String
  address     String
  latitude    Float?
  longitude   Float?
  openingTime String
  closingTime String
  capacity    Int
  photos      String[]
  amenities   String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
  admin       GymAdmin  @relation(fields: [adminId], references: [id])
  packages    Package[]
  trainers    Trainer[]
}

model Package {
  id           Int         @id @default(autoincrement())
  gymId        Int
  name         String
  type         PackageType @default(daily)
  price        Float
  durationDays Int
  benefits     String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  bookings     Booking[]
  gym          Gym         @relation(fields: [gymId], references: [id])
}

model Booking {
  id        Int           @id @default(autoincrement())
  userId    Int
  gymId     Int
  packageId Int?
  slotStart DateTime
  slotEnd   DateTime
  status    BookingStatus @default(pending)
  qrCode    String?       @unique
  createdAt DateTime      @default(now())
  gym       Gym           @relation(fields: [gymId], references: [id])
  package   Package?      @relation(fields: [packageId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  payment   Payment?
}

model Payment {
  id               Int             @id @default(autoincrement())
  userId           Int
  bookingId        Int?            @unique
  amount           Float
  currency         String          @default("ETB")
  status           PaymentStatus   @default(pending)
  chapaTxRef       String?         @unique
  chapaCheckoutUrl String?
  createdAt        DateTime        @default(now())
  trainerSessionId Int?            @unique
  chapaRefundRef   String?         @unique
  booking          Booking?        @relation(fields: [bookingId], references: [id])
  trainerSession   TrainerSession? @relation(fields: [trainerSessionId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
}

model Trainer {
  id                     Int                   @id @default(autoincrement())
  gymId                  Int?
  name                   String
  bio                    String?
  createdAt              DateTime              @default(now())
  email                  String                @unique
  experienceYears        Int?
  passwordHash           String
  profilePhotoUrl        String?
  rating                 Float                 @default(0)
  sessionPrice           Decimal?              @db.Decimal(10, 2)
  specialization         String?
  verificationStatus     VerificationStatus    @default(PENDING)
  phone                  String?
  conversationsAsTrainer Conversation[]
  gym                    Gym?                  @relation(fields: [gymId], references: [id])
  availability           TrainerAvailability[]
  credentials            TrainerCredential[]
  reviews                TrainerReview[]
  sessions               TrainerSession[]      @relation("TrainerSessions")
}

model TrainerCredential {
  id         Int      @id @default(autoincrement())
  trainerId  Int
  fileUrl    String
  label      String?
  uploadedAt DateTime @default(now())
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model TrainerAvailability {
  id        Int     @id @default(autoincrement())
  trainerId Int
  dayOfWeek Int
  startTime String
  endTime   String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

model TrainerSession {
  id         Int            @id @default(autoincrement())
  trainerId  Int
  memberId   Int
  startTime  DateTime
  endTime    DateTime
  status     SessionStatus  @default(PENDING_PAYMENT)
  price      Decimal        @db.Decimal(10, 2)
  chapaTxRef String?        @unique
  createdAt  DateTime       @default(now())
  expiresAt  DateTime?
  payment    Payment?
  review     TrainerReview?
  member     User           @relation("MemberTrainerSessions", fields: [memberId], references: [id])
  trainer    Trainer        @relation("TrainerSessions", fields: [trainerId], references: [id])

  @@index([trainerId, startTime])
  @@index([memberId, startTime])
  @@index([status, expiresAt])
}

model TrainerReview {
  id        Int            @id @default(autoincrement())
  trainerId Int
  memberId  Int
  sessionId Int            @unique
  rating    Int
  review    String?
  createdAt DateTime       @default(now())
  member    User           @relation(fields: [memberId], references: [id])
  session   TrainerSession @relation(fields: [sessionId], references: [id])
  trainer   Trainer        @relation(fields: [trainerId], references: [id])

  @@index([trainerId])
  @@index([memberId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  memberId  Int
  trainerId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  member    User      @relation(fields: [memberId], references: [id])
  trainer   Trainer   @relation(fields: [trainerId], references: [id])
  messages  Message[]

  @@unique([memberId, trainerId])
  @@index([memberId])
  @@index([trainerId])
}

model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  senderType     MessageSenderType
  senderId       Int
  content        String
  isRead         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum MessageSenderType {
  MEMBER
  TRAINER
}

enum PackageType {
  daily
  weekly
  monthly
  annual
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  checked_in
  payment_failed
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  refund_pending
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SessionStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}
