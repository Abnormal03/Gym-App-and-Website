generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String?
  password  String
  photoUrl  String?
  fcmToken  String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  payments  Payment[]
}

model GymAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  gyms      Gym[]
}

model Gym {
  id          Int       @id @default(autoincrement())
  adminId     Int
  name        String
  address     String
  latitude    Float?
  longitude   Float?
  openingTime String
  closingTime String
  capacity    Int
  photos      String[]
  amenities   String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
  admin       GymAdmin  @relation(fields: [adminId], references: [id])
  packages    Package[]
}

model Package {
  id           Int         @id @default(autoincrement())
  gymId        Int
  name         String
  type         PackageType @default(daily)
  price        Float
  durationDays Int
  benefits     String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  bookings     Booking[]
  gym          Gym         @relation(fields: [gymId], references: [id])
}

model Booking {
  id        Int           @id @default(autoincrement())
  userId    Int
  gymId     Int
  packageId Int?
  slotStart DateTime
  slotEnd   DateTime
  status    BookingStatus @default(pending)
  qrCode    String?       @unique
  createdAt DateTime      @default(now())
  gym       Gym           @relation(fields: [gymId], references: [id])
  package   Package?      @relation(fields: [packageId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  payment   Payment?
}

model Payment {
  id               Int           @id @default(autoincrement())
  userId           Int
  bookingId        Int           @unique
  amount           Float
  currency         String        @default("ETB")
  status           PaymentStatus @default(pending)
  chapaTxRef       String?       @unique
  chapaCheckoutUrl String?
  createdAt        DateTime      @default(now())
  booking          Booking       @relation(fields: [bookingId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
}

model Trainer {
  id        Int      @id @default(autoincrement())
  gymId     Int
  name      String?
  bio       String?
  createdAt DateTime @default(now())
}

enum PackageType {
  daily
  weekly
  monthly
  annual
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  checked_in
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}
